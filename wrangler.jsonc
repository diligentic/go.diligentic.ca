{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "go-diligentic-ca",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-25",
  "d1_databases": [
    {
      "binding": "CLICKS_DB",
      "database_name": "go-diligentic-clicks-production",
      "database_id": "a92c75d9-86b8-4003-afa6-d2e318bfc1ec",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "CLICKS_DB",
          "database_name": "go-diligentic-clicks-preview",
          "database_id": "8eada874-cded-4165-b960-4c3e2a341924",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}